<rml>
	<head>
		<title>Reset veil</title>
		<!-- GGA (2026-11-12): black veil of the Reset button, over the game, no input capture; its opacity is set each frame by
		     src/ui/ui_state.cpp from src/game/ga_reset.cpp (fade to black, then back on the boot logos). -->
		<style>
			body
			{
				width: 100%;
				height: 100%;
			}
			#veil
			{
				position: absolute;
				top: 0;
				right: 0;
				bottom: 0;
				left: 0;
				background-color: #000000;
				opacity: 0;
				pointer-events: none;
			}
		</style>
	</head>
	<body>
		<div id="veil"></div>
	</body>
</rml>
